#!/bin/bash

SRC=src
OUT=out
ESBUILD=node_modules/.bin/esbuild
TACHYONS=node_modules/tachyons/css/tachyons.min.css

KANJIAPI_URL=${KANJIAPI_URL:-https://kanjiapi.dev}

rm -rf $OUT
mkdir -p $OUT

echo "Building against $KANJIAPI_URL"

$ESBUILD $SRC/index.js --bundle --minify --sourcemap \
    --define:KANJIAPI_URL="\"$KANJIAPI_URL\"" \
    --outfile=$OUT/index.bundle.js

cp index.html $OUT/index.html
cp $TACHYONS $OUT/
cp kanjikai.css $OUT/

cp favicon.png $OUT/
